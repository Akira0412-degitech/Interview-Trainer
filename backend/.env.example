# Prisma connection string
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"

# Individual DB connection fields (used by Prisma MariaDB adapter)
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
